#!/usr/bin/env python3
"""probe — drive the running app from the command line.

Every subcommand is one endpoint of the HTTP server embedded in the debug build. JSON goes to
stdout, errors go to stderr with exit code 1, so both channels stay machine readable.

  probe/scripts/probe app-info
  probe/scripts/probe ui-snapshot
  probe/scripts/probe tap --x 540 --y 310
  probe/scripts/probe input-text --text "Pancakes"
  probe/scripts/probe screenshot -o /tmp/after.png
"""
from __future__ import annotations

import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import nav_map  # noqa: E402
from probe_client import DEFAULT_PORT, ProbeClient, ProbeError  # noqa: E402


def _out(payload) -> None:
    print(json.dumps(payload, indent=2))


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="probe", description=__doc__.splitlines()[0])
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=DEFAULT_PORT)
    parser.add_argument("--timeout", type=float, default=15.0)

    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("app-info", help="app name, version, package, port")
    sub.add_parser("ui-snapshot", help="ids, text, bounds of everything on screen")
    sub.add_parser("nav-map", help="every screen of the app, its ids and its exits")

    goto = sub.add_parser("goto", help="walk the navigation map to a screen, and land on it")
    goto.add_argument("screen", help="the id of a screen in the map, e.g. toy_detail")
    goto.add_argument(
        "--index",
        help="fills the {index} placeholder of a list row, e.g. --index 2 taps the third card",
    )

    owner = sub.add_parser("owner-of", help="which screen owns this automation id")
    owner.add_argument("id")
    sub.add_parser("logs", help="the last log lines the app emitted")
    sub.add_parser("press-back", help="press the platform back button")

    shot = sub.add_parser("screenshot", help="capture a PNG of the current screen")
    shot.add_argument("-o", "--output", default="screenshot.png")

    tap = sub.add_parser("tap", help="tap at raw coordinates")
    tap.add_argument("--x", type=float, required=True)
    tap.add_argument("--y", type=float, required=True)

    tap_id = sub.add_parser("tap-id", help="tap the centre of the element with this automation id")
    tap_id.add_argument("id")

    swipe = sub.add_parser("swipe", help="swipe between two points")
    swipe.add_argument("--start-x", type=float, required=True)
    swipe.add_argument("--start-y", type=float, required=True)
    swipe.add_argument("--end-x", type=float, required=True)
    swipe.add_argument("--end-y", type=float, required=True)
    swipe.add_argument("--duration-ms", type=int, default=300)

    text = sub.add_parser("input-text", help="type into the focused field, through the real IME")
    text.add_argument("--text", required=True)

    args = parser.parse_args(argv)
    client = ProbeClient(host=args.host, port=args.port, timeout=args.timeout)

    try:
        if args.command == "app-info":
            _out(client.app_info())
        elif args.command == "ui-snapshot":
            _out(client.ui_snapshot())
        elif args.command == "logs":
            _out(client.logs())
        elif args.command == "press-back":
            _out(client.press_back())
        elif args.command == "screenshot":
            with open(args.output, "wb") as f:
                f.write(client.screenshot())
            _out({"ok": True, "output": args.output})
        elif args.command == "tap":
            _out(client.tap(args.x, args.y))
        elif args.command == "tap-id":
            element = _find_by_id(client, args.id)
            if element is None:
                raise ProbeError(f"no element with id {args.id!r} on screen")
            cx = element["x"] + element.get("width", 0) / 2
            cy = element["y"] + element.get("height", 0) / 2
            client.tap(cx, cy)
            _out({"ok": True, "id": args.id, "tapped": {"x": cx, "y": cy}})
        elif args.command == "swipe":
            _out(client.swipe(args.start_x, args.start_y, args.end_x, args.end_y, args.duration_ms))
        elif args.command == "input-text":
            _out(client.input_text(args.text))
        elif args.command == "nav-map":
            _out(client.nav_map())
        elif args.command == "goto":
            params = {"index": args.index} if args.index is not None else {}
            # Progress goes to stderr as it happens, so a long walk is readable while it runs and
            # stdout still holds nothing but the JSON result.
            arrival = nav_map.goto(
                client,
                args.screen,
                params,
                on_step=lambda line: print(line, file=sys.stderr),
            )
            _out({"ok": True, **arrival})
        elif args.command == "owner-of":
            screen = nav_map.owner_of(client.nav_map(), args.id)
            if screen is None:
                raise ProbeError(
                    f"no screen in the map owns {args.id!r}. Add it to the Screen's ids, or check "
                    f"the spelling against probe nav-map."
                )
            _out(screen)
    except ProbeError as e:
        print(json.dumps({"ok": False, "error": str(e)}, indent=2), file=sys.stderr)
        return 1
    return 0


def _find_by_id(client: ProbeClient, target: str):
    """Match on the bare id, so a flow never has to write the "<pkg>:id/" prefix."""
    want = target.rsplit(":id/", 1)[-1]
    for element in client.ui_snapshot().get("elements", []):
        if (element.get("id") or "").rsplit(":id/", 1)[-1] == want:
            return element
    return None


if __name__ == "__main__":
    sys.exit(main())
